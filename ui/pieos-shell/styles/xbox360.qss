/*=============================================================================
  Pie OS - Xbox 360 Inspired Theme Stylesheet
  Tema: Verde claro (#A8D854) com fundo escuro, mínimo de azul
=============================================================================*/

/* === GLOBAL === */
QWidget {
    background-color: #1a1a1a;
    color: #ffffff;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #1a1a1a;
}

/* === BLADES NAVIGATION === */
BladePanel {
    background-color: #2a2a2a;
    border-bottom: 1px solid #333333;
}

BladeButton {
    background-color: transparent;
    color: #999999;
    border: none;
    font-size: 14px;
    font-weight: normal;
    padding: 10px 24px;
    border-radius: 8px;
}

BladeButton:hover {
    background-color: #4a4a4a;
    color: #ffffff;
}

BladeButton[active="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #C8F066, stop:0.5 #A8D854, stop:1 #7AB832);
    color: #1a1a1a;
    font-weight: bold;
}

/* === GAME CARDS === */
GameCard {
    background-color: #222222;
    border: 2px solid #333333;
    border-radius: 18px;
}

GameCard:hover {
    border: 2px solid #A8D854;
}

/* === SCROLLBARS === */
QScrollArea {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    background: #1a1a1a;
    width: 6px;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background: #A8D854;
    border-radius: 3px;
    min-height: 30px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

/* === BUTTONS === */
QPushButton {
    background-color: #A8D854;
    color: #1a1a1a;
    border: none;
    border-radius: 10px;
    padding: 8px 24px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #C8F066;
}

QPushButton:pressed {
    background-color: #7AB832;
}

/* === DIALOGS === */
QDialog {
    background-color: #1a1a1a;
    border: 2px solid #A8D854;
    border-radius: 20px;
}

QListWidget {
    background-color: #222222;
    border: 1px solid #333333;
    border-radius: 10px;
    color: #ffffff;
    font-size: 13px;
}

QListWidget::item {
    padding: 12px 16px;
    border-bottom: 1px solid #333333;
}

QListWidget::item:hover {
    background-color: #3a3a3a;
}

QListWidget::item:selected {
    background-color: #A8D854;
    color: #1a1a1a;
}

/* === SLIDER === */
QSlider::groove:horizontal {
    background: #333333;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #A8D854;
    width: 20px;
    height: 20px;
    margin: -7px 0;
    border-radius: 10px;
}

QSlider::sub-page:horizontal {
    background: #A8D854;
    border-radius: 3px;
}

/* === BOTTOM BAR === */
#bottomBar {
    background-color: #2a2a2a;
    border-top: 1px solid #333333;
}

/* === PROGRESS BAR === */
QProgressBar {
    background: #222222;
    border: 1px solid #333333;
    border-radius: 6px;
    text-align: center;
    color: #ffffff;
    font-size: 11px;
    height: 16px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #7AB832, stop:1 #A8D854);
    border-radius: 5px;
}
